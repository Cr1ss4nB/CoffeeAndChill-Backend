# PostgreSQL / Supabase
# Replace [YOUR-PASSWORD] with the password from your Supabase project.
# Supabase pooler typically requires sslmode=require.
DATABASE_URL=postgresql://postgres.ybkinjzcgdvundzjrmlg:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Optional local Postgres values if you run the `localdb` profile.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres_pass
# POSTGRES_DB=coffee_chill

# Optional local overrides
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOW_STOCK_THRESHOLD=10
FRONTEND_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# Media local fallback (desarrollo)
MEDIA_DIR=./media

# Supabase Storage (producción / híbrido)
# Si defines estas variables, las imágenes nuevas se subirán a Supabase.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_BUCKET=product-images
SUPABASE_PRODUCTS_PREFIX=products
# true: si falla Supabase, devuelve error. false: cae a almacenamiento local /media.
SUPABASE_STORAGE_STRICT=false
