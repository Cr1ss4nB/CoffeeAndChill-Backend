# ==========================================
# Desarrollo local (Docker)
# ==========================================
# Variables usadas por el servicio db de docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass
POSTGRES_DB=coffee_chill

# ==========================================
# Base de datos que usa el backend
# Prioridad en código:
# 1) Si DATABASE_URL está definida, usa esa.
# 2) Si DATABASE_URL está vacía, construye desde DB_*.
# ==========================================
# Opción A (recomendada): variables separadas (DB_*)
DB_DIALECT=postgresql+psycopg2
# Para pooler usa: postgres.<project-ref>
DB_USER=postgres.ybkinjzcgdvundzjrmlg
DB_PASSWORD=coffeeandchill123
# Session pooler (IPv4, recomendado para tu caso con Docker)
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# Direct connection (te falló por IPv6 en Docker):
# DB_HOST=db.ybkinjzcgdvundzjrmlg.supabase.co
# DB_PORT=5432

# Transaction pooler (alternativa):
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543

# Copia estos 2 valores EXACTOS desde Supabase > Connect > ORM > SQLAlchemy:
# - User (pooler): postgres.<project-ref>
# - Host (Session pooler): <algo>.pooler.supabase.com

# Opción B: URL completa (dejar vacía para usar DB_*)
DATABASE_URL=

# Docker local (descomenta si quieres usar Postgres local en contenedor db):
# DATABASE_URL=postgresql://postgres:postgres_pass@db:5432/coffee_chill

# Si Direct connection falla desde Docker, prueba el Session/Transaction pooler
# y reemplaza DATABASE_URL por la cadena que te da Supabase para SQLAlchemy.

# Redis en Docker Compose
REDIS_URL=redis://redis:6379/0
# Redis local fuera de Docker (opcional)
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# Seguridad Auth
# ==========================================
SECRET_KEY=clave-secreta-de-desarrollo-muy-larga-y-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30